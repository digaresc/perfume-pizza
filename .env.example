# owner/name of the repo whose merged PRs drive the race.
# On Vercel this falls back to VERCEL_GIT_REPO_OWNER/VERCEL_GIT_REPO_SLUG when the project is git-connected.
GITHUB_REPO=digaresc/perfume-pizza
# Optional but strongly recommended (raises the GitHub API limit from 60 to 5000 req/h). Read-only scope is enough.
GITHUB_TOKEN=
# Secret configured on the GitHub webhook (optional; webhook only busts the cache for instant updates).
GITHUB_WEBHOOK_SECRET=
# Race start (ISO 8601). The race lasts 80 minutes. Can also be overridden with /?start=2026-10-29T18:00:00Z
EVENT_START=
# Steps from the gate to the finish line (one step per merged PR).
TRACK_LENGTH=10
# CRM login
ADMIN_USER=chef
ADMIN_PASSWORD=margherita-no-5
AUTH_SECRET=change-me-to-a-long-random-string
